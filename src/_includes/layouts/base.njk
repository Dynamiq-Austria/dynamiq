{% set ui = i18n[pageLang or "de"] %}
<!DOCTYPE html>
<html lang="{{ ui.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#a457e8">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  <link rel="canonical" href="{{ siteUrl }}{{ page.url }}">
  {% if alternatePage %}
    <link rel="alternate" hreflang="{{ 'de' if ui.lang == 'en' else 'en' }}" href="{{ siteUrl }}{{ alternatePage }}">
    <link rel="alternate" hreflang="{{ ui.lang }}" href="{{ siteUrl }}{{ page.url }}">
    <link rel="alternate" hreflang="x-default" href="{{ siteUrl }}/">
  {% endif %}

  {% set socialImage = ogImage or "/assets/og-image-data-intelligence.png" %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ ui.ogLocale }}">
  <meta property="og:site_name" content="Dynamiq">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ ogDescription or description or site.description }}">
  <meta property="og:url" content="{{ siteUrl }}{{ page.url }}">
  <meta property="og:image" content="{{ siteUrl }}{{ socialImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ ogDescription or description or site.description }}">
  <meta name="twitter:image" content="{{ siteUrl }}{{ socialImage }}">

  <title>{{ title }}</title>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css">

