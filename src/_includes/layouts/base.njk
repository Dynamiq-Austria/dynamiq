</head>
<body>
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  {% include "components/header.njk" %}

  <main id="main"{% if mainClass %} class="{{ mainClass }}"{% endif %}>
    {{ content | safe }}
  </main>

  {% if showFooter != false %}{% include "components/footer.njk" %}{% endif %}
  {% if showNavigation %}<script src="/script.js?v=interactive-hero-letters" defer></script>{% endif %}
</body>
</html>
